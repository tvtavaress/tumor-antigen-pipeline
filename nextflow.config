params {
    input = null
    outdir = 'results'
    specificity = 'hpa'
    pan_cancer = false
    gene_name_mapping = null
}

process {
    cpus = 2
    memory = '4 GB'
    time = '2h'
}

conda.enabled = true

profiles {
    standard {
        process.executor = 'local'
    }

    test {
        params.input = 'assets/test.h5ad'
        params.outdir = 'results_test'
    }
}